# Identifiants WhatsApp Cloud API (https://developers.facebook.com/apps -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optionnel
WHATSAPP_API_VERSION=v21.0
PORT=3000
# Mettre à 1 pour simuler les envois sans appeler Meta (activé automatiquement si le token est absent)
DRY_RUN=0
